{
  // AURENIX Founder Upload Worker  (v11 — Shadow Nexus storage only)
  // Deploy: cd upload-worker && npx wrangler deploy
  //
  // ══════════════════════════════════════════════════════════
  //  REQUIRED SECRETS — Supabase + Firebase
  // ══════════════════════════════════════════════════════════
  //   npx wrangler secret put SUPABASE_URL
  //     → enter: https://nxsyoreuwmmxtuvmeqbg.supabase.co
  //
  //   npx wrangler secret put SUPABASE_SERVICE_KEY
  //     → enter: <service-role key from Supabase Dashboard → Settings → API>
  //
  //   npx wrangler secret put FIREBASE_PROJECT_ID
  //     → enter: remix-studio-4bf8a
  //
  //   npx wrangler secret put FIREBASE_SERVICE_ACCOUNT_KEY
  //     → enter: <full JSON from Firebase Console → Service Accounts → Generate new private key>
  //     Required for server-side channel auto-advance.
  //
  // ══════════════════════════════════════════════════════════
  //  OPTIONAL — Supabase Management API (raises project-level upload limit)
  // ══════════════════════════════════════════════════════════
  //   npx wrangler secret put SUPABASE_MANAGEMENT_TOKEN
  //     → get a personal access token from https://supabase.com/dashboard/account/tokens
  //
  // ══════════════════════════════════════════════════════════
  //  Google Drive has been removed.
  //  All media is stored on Shadow Nexus (Supabase aurenix-media bucket).
  //  No GDRIVE_KV, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, or GOOGLE_REDIRECT_URI
  //  are needed or used.
  // ══════════════════════════════════════════════════════════

  "name": "aurenix-upload",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",

  // Workers Logs — structured observability
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }

  // No KV, R2, D1, or other bindings required.
  // Supabase is called over fetch() using a secret service-role key.
}
